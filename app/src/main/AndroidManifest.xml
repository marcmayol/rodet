<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Sin camara se puede elegir la foto de la galeria o rellenar a mano. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- A proposito NO obligatorio: sin NFC la app sirve para el inventario. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".RodetApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".flow.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gcode o 3MF laminado, abierto o compartido: va a la calculadora. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-gcode" />
                <data android:mimeType="application/x-gcode" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml" />
            </intent-filter>
            <!-- Los gestores de archivos suelen dar el gcode como binario generico: solo
                 "Abrir con", no en el menu de compartir de cualquier fichero. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Lector de tags: se abre desde la pantalla de maquina. -->
        <activity
            android:name=".reader.ReaderActivity"
            android:exported="false"
            android:launchMode="singleTop" />
    </application>
</manifest>
